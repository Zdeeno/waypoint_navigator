<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>waypoint_follower</name>
  <version>0.0.1</version>
  <description>Buffers incoming waypoints and drives the robot along them by publishing Twist commands to cmd_vel using a NAV2-style pure pursuit controller.</description>

  <maintainer email="rozsyzde@fel.cvut.cz">zdeeno</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>whycode_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
